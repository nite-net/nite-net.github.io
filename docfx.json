{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "nite-src/src/Nite",
          "files": ["Nite.csproj"]
        }
      ],
      "dest": "api",
      "namespaceLayout": "flattened",
      "memberLayout": "samePage",
      "enumSortOrder": "declaringOrder",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "properties": {
        "Configuration": "Release"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": ["**/*.{md,yml}"],
        "exclude": ["_site/**", "obj/**", "nite-src/**", "README.md", "CLAUDE.md", ".github/**"]
      }
    ],
    "resource": [
      {
        "files": ["images/**", ".nojekyll", "CNAME"]
      }
    ],
    "output": "_site",
    "template": ["default", "modern", "template"],
    "postProcessors": [],
    "keepFileLink": false,
    "disableGitFeatures": false,
    "globalMetadata": {
      "_appName": "NiteFx",
      "_appTitle": "NiteFx",
      "_appLogoPath": "images/icon-64.png",
      "_appFaviconPath": "images/favicon-32.png",
      "_appFooter": "NiteFx is licensed under the <a href=\"https://github.com/nite-net/nite/blob/main/LICENSE\">Apache License 2.0</a>. Built with <a href=\"https://dotnet.github.io/docfx/\">DocFX</a>. <a href=\"/docs/code-signing.html\">Code signing policy</a> · <a href=\"/docs/privacy.html\">Privacy policy</a>",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/nite-net/nite-net.github.io",
        "branch": "main"
      },
      "_lang": "en",
      "_description": "TypeScript and React for ASP.NET Core with a Vite-style dev loop and no Node.js toolchain.",
      "og:image": "images/social-card.png"
    },
    "sitemap": {
      "baseUrl": "https://nitefx.dev/",
      "changefreq": "weekly",
      "priority": 0.5
    }
  }
}
